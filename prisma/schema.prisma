// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// engineType = "client" drops the native Rust query-engine binary entirely —
// queries run through the pg driver adapter (lib/prisma.ts) instead. Avoids
// the class of "query engine not found" bundling failures on serverless
// platforms like Vercel, where the custom output path confuses file tracing.
generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A connected Slack workspace (formerly the `slack_workspaces` Firestore collection).
model Workspace {
  id               String   @id // Slack team.id
  name             String
  botToken         String // AES-256-GCM encrypted, see lib/tokenCrypto.ts
  appId            String?
  botUserId        String?
  scopes           String?
  installationDate DateTime @default(now())
  status           String   @default("active")

  userStatuses     UserStatus[]
  activitySessions ActivitySession[]

  @@map("slack_workspaces")
}

// Latest known Slack status/presence for a user (formerly `user_statuses`).
// Keyed by the Slack user id, matching the previous Firestore document id.
model UserStatus {
  userId           String    @id
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  presence         String?
  lastPresence     String?
  activeSessionId  String?
  statusText       String?
  statusEmoji      String?
  statusExpiration Int?
  realName         String?
  displayName      String?
  imageOriginal    String?
  updatedAt        DateTime

  @@index([workspaceId])
  @@map("user_statuses")
}

// A single active/away work session for a user (formerly `activity_sessions`).
model ActivitySession {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  lastSeen    DateTime

  @@index([userId, workspaceId, startTime])
  @@index([workspaceId, startTime])
  @@map("activity_sessions")
}

// Lease used by the presence cron so overlapping scheduler runs cannot both
// write sessions (see withCronLease in lib/presenceSync.ts).
model CronLock {
  name        String   @id
  lockedUntil DateTime @map("locked_until")

  @@map("cron_locks")
}
